  "findings": [
    {
      "id": "REL-2026-01",
      "severity": "medium",
      "status": "FAIL",
      "category": "reliability",
      "title": "SafeFetcher does not retry HTTP 429 or 503",
      "evidence": [
        "REL-RETRY-001",
        "REL-RETRY-002"
      ],
      "measured": "One request reached each fixture; both returned status=error/http_error. No second attempt occurred.",
      "impact": "A transient provider rate limit or maintenance response is surfaced as a terminal error. Callers may retry, but the core fetch contract advertises retryable errors without honoring them.",
      "remediation": "Add a bounded retry policy for 429/502/503/504 with Retry-After honoring, a maximum of 2 attempts, jitter, and a total deadline. Preserve retry counts in evidence.",
      "rerun_required": "Yes for the reliability gate; quality evidence was collected before this policy change and is unaffected if the search adapters are not changed."
    },
    {
      "id": "SEC-2026-01",
      "severity": "low",
      "status": "PASS",
      "category": "injection",
      "title": "Injection content is flagged but still returned to callers",
      "evidence": [
        "SEC-INJ-003",
        "SEC-INJ-004"
      ],
      "measured": "The injected passage was flagged ignore_instructions and the safe fixture text remained available; the comment fixture produced html_comment_instructions.",
      "impact": "A caller that ignores flags can still consume the injected text. This is a documented data-not-instructions contract, not a sanitizer guarantee.",
      "remediation": "Consumers must isolate or strip flagged passages. Consider a strict mode that drops flagged passages and returns a warning-only payload.",
      "rerun_required": "No; behavior is intentional and documented.",
      "residual_risk": true
    }
  ],
