  "cases": [
    {
      "id": "asyncio_timeout",
      "query": "Does asyncio.timeout cancel the task when the deadline expires?",
      "expected_status": "ok",
      "findings": [
        {
          "claim": "asyncio.timeout() cancels the task when the deadline expires.",
          "url": "https://docs.python.org/3/library/asyncio-task.html",
          "published": "2026-01-10"
        },
        {
          "claim": "asyncio.timeout does not cancel the task when the deadline expires; the caller must cancel it.",
          "url": "https://blog.example.com/asyncio",
          "published": "2025-06-01"
        }
      ],
      "expected": [
        {"kind": "polar", "polarity": "affirmative", "verdict": "supported"},
        {"kind": "polar", "polarity": "negative", "verdict": "refuted"}
      ]
    },
